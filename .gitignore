# ==============================================================================
# Enterprise Knowledge Assistant - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Markdown Documentation (Exclude all markdown files except README.md)
# ------------------------------------------------------------------------------
*.md
!README.md
!readme.md
!**/README.md
!**/readme.md


# ------------------------------------------------------------------------------
# 1. .NET & C# Build Artifacts
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
dist/
*.pubxml
*.pubxml.user

# Visual Studio / Visual Studio Code
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.ide/
.idea/

# Unit Test & Code Coverage Results
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# EF Core & Local Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 2. Node.js, Vite & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.eslintcache
.parcel-cache/

# NPM / Yarn / PNPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Python & RAGOps Evaluation Environment
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 4. Local User Uploads, Storage & Runtime Documents
# ------------------------------------------------------------------------------
uploads/
**/uploads/
storage/
**/storage/
temp/
**/temp/
*.tmp

# ------------------------------------------------------------------------------
# 5. Secrets, API Keys & Environment Configuration
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
appsettings.Local.json
appsettings.Development.json
secrets.json

# Certificates & Private Keys
*.pfx
*.p12
*.pem
*.key
*.crt

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
